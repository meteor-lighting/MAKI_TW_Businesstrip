VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Local migration scripts only. Never expose this as a VITE_ variable.
# SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
# Required while creating migrated Auth users on projects whose Auth endpoint
# does not yet accept the new secret key. Copy the legacy service_role JWT.
# SUPABASE_SERVICE_ROLE_KEY=eyJ_REPLACE_ME
